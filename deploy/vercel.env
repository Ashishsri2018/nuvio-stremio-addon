# Non-secret Vercel runtime configuration.
# Sync with scripts/apply-vercel-env.sh; keep secrets out of this file.
LOG_LEVEL=info
NUVIO_SOURCE=eclipsia/nuvio-plugin
NUVIO_BRANCH=main
NUVIO_UPDATE_INTERVAL_HOURS=24
NUVIO_CONCURRENCY=8
SCRAPER_CONCURRENCY=60
SCRAPER_TIMEOUT_MS=12000
GLOBAL_DEADLINE_MS=25000
HTTP_TIMEOUT_MS=15000
STREAM_CACHE_TTL_MS=60000
PROXY_ENABLED=true
