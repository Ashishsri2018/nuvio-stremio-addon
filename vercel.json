{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/index" },
    { "source": "/stream/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/cron/refresh.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/refresh", "schedule": "0 3 * * *" }
  ]
}
