{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "buildCommand": "npm run bake && npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/index" },
    { "source": "/configure", "destination": "/api/index" },
    { "source": "/stream/:path*", "destination": "/api/index" },
    { "source": "/subtitles/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/:config/manifest.json", "destination": "/api/index" },
    { "source": "/:config/configure", "destination": "/api/index" },
    { "source": "/:config/stream/:path*", "destination": "/api/index" },
    { "source": "/:config/subtitles/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "snapshot/**" },
    "api/cron/refresh.ts": { "maxDuration": 60, "includeFiles": "snapshot/**" }
  },
  "crons": [
    { "path": "/api/cron/refresh", "schedule": "0 3 * * *" }
  ]
}
